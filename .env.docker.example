# Docker Environment Configuration
# Copy this file to .env and update values as needed

# Django Settings
PYTHONUNBUFFERED=1
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SUPERUSER_EMAIL=admin@foundation.local
DJANGO_SUPERUSER_PASSWORD=admin123456

# PostgreSQL Database
POSTGRES_DB=foundation
POSTGRES_USER=foundation
POSTGRES_PASSWORD=foundation_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgres://foundation:foundation_secure_password@db:5432/foundation

# Redis Cache/Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Email Configuration (MailHog)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@foundation.local
SERVER_EMAIL=server@foundation.local

# MinIO S3-Compatible Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_BUCKET=foundation-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_STORAGE_BUCKET_NAME=foundation-dev
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_CUSTOM_DOMAIN=localhost:9000/foundation-dev
AWS_DEFAULT_ACL=public-read
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_AUTH=False

# Security Keys
API_WEBHOOK_SECRET=your-webhook-secret-here

# Feature Flags
ENABLE_PROMETHEUS_METRICS=True
ENABLE_HEALTH_CHECKS=True

# Logging
LOG_LEVEL=INFO