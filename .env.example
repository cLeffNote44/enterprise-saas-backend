# Enterprise SaaS Foundation Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.yourdomain.com

# Database Configuration
DATABASE_URL=sqlite:///foundation_dev.db
# DATABASE_URL=postgresql://user:password@localhost/foundation_db

# Redis Configuration (optional in development)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-password

# Security Settings
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com
API_WEBHOOK_SECRET=your-webhook-secret-here

# External Services
# SENTRY_DSN=your-sentry-dsn-here

# Feature Flags
API_KEY_ROTATION_DAYS=90
